--- a/src/components/implementation/simple_vmm/vmm/Makefile
+++ b/src/components/implementation/simple_vmm/vmm/Makefile
@@
 C_OBJS+=$(CFILES:%.c=%.o)
 COMP_FLAGS= -mavx -mavx2 -mfma -I$(LIBDIR)/dpdk/dpdk/build/install/include
-private:
-	cd guest && make && cd ..
+
+# Guest images. VM_IMAGE selects a recipe from ../vmimg/recipes/.
+VM_IMAGE  ?= shell
+VMIMG_DIR := $(CURDIR)/../vmimg
+GUEST_DIR := $(CURDIR)/guest
+
+# simple_vmm.c INCBINs both of these, so they must exist before it compiles.
+# Expressing that as a real prerequisite rather than leaving it to the ordering
+# of the `all:` list in Makefile.subsubdir, which builds $(COMPOBJ) first.
+simple_vmm.o: $(GUEST_DIR)/vmlinux.img $(GUEST_DIR)/guest.img
+
+$(GUEST_DIR)/guest.img:
+	$(MAKE) -C $(GUEST_DIR)
+
+$(GUEST_DIR)/vmlinux.img:
+	$(MAKE) -C $(VMIMG_DIR) image RECIPE=$(VM_IMAGE)
+	$(MAKE) -C $(VMIMG_DIR) install RECIPE=$(VM_IMAGE) DESTDIR=$(GUEST_DIR)
+
+private: $(GUEST_DIR)/guest.img $(GUEST_DIR)/vmlinux.img
 
 include Makefile.subsubdir
